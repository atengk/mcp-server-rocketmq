# ==============================================================================
# mcp-server-rocketmq 容器化环境变量示例配置
# 复制此文件为 .env 并按需调整具体连接地址与鉴权密钥
# ==============================================================================

# 容器服务对外暴露端口 (优先读取 MCP_SERVER_PORT)
MCP_SERVER_PORT=8080

# MCP 协议通信传输模式 (可选: sse / stdio，容器部署建议使用 sse)
MCP_TRANSPORT=sse

# RocketMQ Remoting 协议运维管理端连接地址 (NameServer)
# 如果 RocketMQ 运行于宿主机，可保留 host.docker.internal；远程集群填写对应 IP:Port
MCP_ROCKETMQ_NAMESRV_ADDR=host.docker.internal:9876

# RocketMQ 5.x gRPC 协议消息投递端点 (Proxy / Endpoint)
MCP_ROCKETMQ_ENDPOINTS=host.docker.internal:8081

# RocketMQ ACL 鉴权凭证 (若集群未开启 ACL 可留空)
MCP_ROCKETMQ_ACCESS_KEY=
MCP_ROCKETMQ_SECRET_KEY=

# 安全守卫机制
# 全局只读开关 (true: 拦截所有消息发送与集群修改操作)
MCP_ROCKETMQ_READ_ONLY=false
# 双层防呆破坏性工具开关 (true: 允许调用删除Topic、重置位点等破坏性工具)
MCP_ROCKETMQ_ENABLE_DESTRUCTIVE_TOOLS=false

# JVM 内存与容器调优参数
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
